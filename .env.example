CMS_HTTP_ADDR=:8080
CMS_ADMIN_DATABASE_URL=./cms-admin.db
CMS_APPLICATION_DATABASE_URL="host=localhost user=cms password=cms dbname=cms port=5432 sslmode=disable"
CMS_ALLOWED_ORIGINS=http://localhost:5173
CMS_SESSION_TTL=24h

# Download this file from Google Cloud Console and keep it untracked.
CMS_GOOGLE_CLIENT_FILE=./client_secret_<client-id>.json
CMS_GOOGLE_CLIENT_ID=
CMS_GOOGLE_CLIENT_SECRET=
CMS_GOOGLE_REDIRECT_URL=http://localhost:5173/api/auth/google/callback

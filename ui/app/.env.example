# Leave empty in development; Vite proxies API requests to localhost:8080.
# Set this to the public backend URL when the frontend is hosted separately.
#
# There is no sign-in endpoint: the upstream SSO proxy authenticates the owner
# and the backend trusts the header it forwards.
VITE_API_BASE_URL=
VITE_SESSION_ENDPOINT=/api/auth/session
VITE_CONTENT_ENDPOINT=/api/content
